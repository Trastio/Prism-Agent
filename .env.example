# Prism-Agent 环境变量样例
# 复制为 .env 并填入真实值。所有 Key 均通过环境变量注入，代码零硬编码。

# ---- 运行环境 ----
PRISM_ENV=dev                # dev / prod；prod 下缺失关键配置会 fail-closed 拒绝启动

# ---- LLM（模型侧，按所用服务填写）----
DEEPSEEK_API_KEY=            # DeepSeek 平台 Key
ZHIPU_KEY=                   # 智谱 GLM 平台 Key

# ---- 社媒数据（舆情采集，可选）----
TIKHUB_KEY=                  # TikHub API Key（付费服务，需自行开通）
TIKHUB_DAILY_BUDGET=8        # 每日采集预算护栏（次/轮）

# ---- 观测（可选，Langfuse 自建栈）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=           # 例如 http://localhost:3000

# ---- 服务口令（生产部署）----
PRISM_ADMIN_PASSWORD=        # 登录门禁管理员口令；示例脚本中的 CHANGE_ME_* 均为占位
PRISM_SSH_PASS=              # 部署脚本 SSH 口令（仅本地部署用，不入库）
