# 舆情看板环境配置样例（S-2）
# 复制为 .env 并填入真实值

# ── 服务 ──
HOST=127.0.0.1          # 监听地址（127.0.0.1=仅本机，0.0.0.0=局域网）
PORT=8000

# ── TikHub 采集 API（api.tikhub.dev 转售，按次计费）──
TIKHUB_KEY=
TIKHUB_BASE_URL=https://api.tikhub.dev

# ── LLM 配置（.secrets 文件，非 .env）──
# .secrets 含 glm/deepseek/local_model 的 api_key/base_url/model/password
# 样例见 utils/config.py 的 load_api_config 字段结构
