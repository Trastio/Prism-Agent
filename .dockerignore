# 构建上下文为项目根：排除依赖、产物、密钥、数据与日志，避免镜像膨胀和泄密
node_modules/
prism-web/node_modules/
prism-web/dist/
.pi/agent-minimal/npm/node_modules/

# 密钥与本地配置一律不进镜像（运行时通过 env / volume 注入）
.env
.env.*
!.env.example
*.secrets
.secrets
prism-api/.env
prism-sentiment/.secrets
prism-dashboards/.env

# 数据库与运行数据
*.db
*.db-journal
*.db-wal
*.db-shm
**/data/
.pi/sessions/
.pi/*.log
logs/
backups/

# 与本镜像无关的大目录
eval/
文档/
设计图总览/
业务数据/
工作⓪-E5端到端/
.screenshots/
tests/
ai-agent-book/
