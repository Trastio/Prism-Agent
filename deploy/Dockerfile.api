# prism-api：FastAPI(8002) + pi_gateway(9200) 双运行时
# 构建上下文为项目根，故 COPY 路径带 prism-api/ 前缀
# pi 包使用 enableCompileCache（Node 22+ API），Node 20 会 SyntaxError → 必须 22
FROM node:22-bookworm-slim

ENV TZ=Asia/Shanghai \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production

# bookworm 自带 python3.11；用 venv 隔离 pip 依赖
# apt 换清华源（官方源在国内约 20 分钟，换源后分钟级）
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; \
    else \
      sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app/prism-api

# 依赖层单独缓存
COPY prism-api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

COPY prism-api/package.json ./package.json
# 扩展(src/tools/_shared.ts)直接 import better-sqlite3；装到 /app 供 .pi/extensions 向上解析
RUN npm config set registry https://registry.npmmirror.com \
 && npm install --omit=dev --no-audit --no-fund \
 && mkdir -p /app && cd /app && npm install --omit=dev --no-audit --no-fund better-sqlite3

# 业务源码（.dockerignore 已排除 .env / node_modules / 临时文件）
COPY prism-api/main.py prism-api/pi_gateway.mjs prism-api/map_event.mjs prism-api/abort_note.mjs ./

# 提示词层（pi 从 PROJECT_ROOT 读取；.pi/skills 与 .pi/extensions 由 volume 挂载）
# 2026-11-02 A1a：补齐通用层与分析框架层，避免线上缺文件被空 catch 静默吞掉
COPY AGENTS.md SYSTEM.md PRISM_GENERAL.md PRISM_ANALYSIS.md /app/
# .pi/extensions/prism-guardrails 跨目录引用 ../../../src/verify/completion.ts（漏拷=扩展加载失败→网关崩）
COPY src/ /app/src/

# Linux 版 pi 由 npm 包提供；云上必须用该路径，本机默认 pi.exe 不受影响
ENV PI_BIN=/app/prism-api/node_modules/.bin/pi \
    PRISM_AUTO_APPROVE_UI=1 \
    PRISM_API_HOST=0.0.0.0

EXPOSE 8002 9200

# 网关先起，API 依赖其 9200
CMD ["sh", "-c", "node pi_gateway.mjs & exec python3 -X utf8 main.py"]
