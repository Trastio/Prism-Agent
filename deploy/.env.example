# Prism 上云环境模板：复制为 deploy/.env 后填值（.env 不入库）
# docker compose 会自动读取同目录 .env

# ── 路径（本机默认走项目目录；云上改为数据盘）──
PRISM_DATA_DIR=./data
PRISM_DOTPI_DIR=../.pi
PRISM_EVENTS_DB=../prism_events.db

# ── 端口 ──
PRISM_HTTP_PORT=80
PRISM_OPS_PORT=8020

# ── 生产必设（fail-closed：PRISM_ENV=prod 时缺 secret 直接拒启）──
PRISM_ENV=prod
PRISM_AUTH_SECRET=
PRISM_MANAGER_PASSWORD=

# ── 模型与采集密钥 ──
DEEPSEEK_API_KEY=
TIKHUB_KEY_PRISM=

# ── CORS（云上同源反代可留空；独立域名时填）──
PRISM_ALLOWED_ORIGIN=
